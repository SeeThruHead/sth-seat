{
  "name": "sth-seat",
  "version": "0.4.2",
  "description": "Makes all of your machines act like the one you are sitting at, for you and your coding agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun run setup",
    "setup": "bun run patch && lefthook install",
    "patch": "effect-tsgo patch --oxlint",
    "unpatch": "effect-tsgo unpatch --oxlint",
    "moon": "moon",
    "check": "moon run :check",
    "check:affected": "moon run :check --affected",
    "ci": "dagger call check --source ."
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@moonrepo/cli": "2.6.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@effect/vitest": "4.1.2",
    "effect": "4.1.2"
  }
}
