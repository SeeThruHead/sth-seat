{
  "name": "@sth-seat/protocol",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@sth-seat/lint": "workspace:*",
    "@types/bun": "1.4.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
